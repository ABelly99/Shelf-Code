# SHELFCODE settings.
# After a change, run:  sudo systemctl restart shelfcode

# Port for the web interface.
SHELFCODE_PORT=8765

# Address to listen on. 0.0.0.0 = all networks. Use 127.0.0.1 behind a reverse proxy (nginx, Caddy…).
SHELFCODE_HOST=0.0.0.0

# Require a PIN on every device (can also be set in the app: Settings → Network).
#SHELFCODE_PIN=1234

# Data folder (database, photos, backups). If you move it, also allow it in the service:
#   sudo systemctl edit shelfcode   →   [Service]  ReadWritePaths=/your/folder
#SHELFCODE_DATA=/var/lib/shelfcode

# Time zone for daily backups and dates (default: the server's).
#TZ=Europe/Berlin
