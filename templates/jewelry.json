{
  "name": "Jewelry",
  "description": "Type, metal, purity, weight, stone. Tiny Data Matrix labels.",
  "color": "#B3261E",
  "code_prefix": "JW-",
  "default_format": "datamatrix",
  "label_template": "Tiny 25×15 (code only)",
  "fields": [
